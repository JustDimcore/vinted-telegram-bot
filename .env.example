# =============================================================================
# Telegram
# =============================================================================

# Token of your bot, obtained from @BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN="YOUR_BOT_TOKEN"

# Numeric Telegram user IDs of the bot administrators, separated by commas.
# Admins bypass the subscription limit and can use the /admin_* commands.
# You can get your own id from @userinfobot.
TELEGRAM_ADMIN_IDS=""

# Only these user IDs may use the bot (comma separated). Leave empty to let anyone use it.
TELEGRAM_ALLOWED_USER_IDS=""

# How many photos of an item to send.
# 1  -> a single photo with a caption and inline buttons (recommended)
# 2+ -> an album (media group); Telegram does not allow buttons under an album,
#       so the links are placed in the caption instead
ITEM_PHOTOS=1

# =============================================================================
# Vinted
# =============================================================================

# Default marketplace, used until a search says otherwise.
# Every search is queried on the marketplace of its own URL, so a vinted.pl link is
# watched on vinted.pl. This value only decides where the bot looks when it cannot tell,
# and which language the item texts coming from Vinted are in (co.uk, fr, de, pl, lt, ...).
VINTED_API_DOMAIN_EXTENSION="fr"

# Pause between two checks of one subscription, in seconds. Every pause is a random value
# between the two numbers, and after a failed check the pause doubles, up to 30 minutes.
# Without MONITOR_INTERVAL_MAX_SECONDS the upper bound is 1.5 times the lower one.
# Checking too often gets the bot blocked by the bot protection of Vinted.
MONITOR_INTERVAL_SECONDS=60
MONITOR_INTERVAL_MAX_SECONDS=90

# Auto blacklist country codes (for example "uk,fr,us")
BLACKLISTED_COUNTRIES_CODES="uk"

# =============================================================================
# Users
# =============================================================================

# How many searches a single user may run at the same time
USER_MAX_SUBSCRIPTIONS_DEFAULT=5

# Allow ordinary users to create subscriptions (0 = only admins, 1 = everyone)
ALLOW_USER_TO_CREATE_SUBSCRIPTIONS=1

# Ask the user whether an untouched subscription should be kept (0 = false, 1 = true)
ENABLE_SUBSCRIPTION_INACTIVITY=0

# Hours of inactivity before the bot asks whether to keep the subscription
SUBSCRIPTION_INACTIVITY_HOURS=72

# Hours to wait for the answer before the subscription is deleted
SUBSCRIPTION_INACTIVITY_DELETE_HOURS=24

# =============================================================================
# Proxies
# =============================================================================

# Take the proxies from Webshare.io (0 = false, 1 = true).
# With 0 the proxies are read from "proxies.txt" in the root folder,
# one per line in the format ip:port:username:password.
# The bot also runs without any proxy at all - just leave USE_WEBSHARE=0 and
# create no proxies.txt.
USE_WEBSHARE=0

# Webshare.io API key, only used when USE_WEBSHARE=1
WEBSHARE_API_KEY=""

# =============================================================================
# Advanced
# =============================================================================

# Write the logs into app.log as well (0 = false, 1 = true)
DUMP_LOGS=0

# Connection string of the database. The value below matches docker-compose.yml.
MONGODB_URI="mongodb://mongodb:27018/vinted"

# Allow mongo express (0 = false, 1 = true). Set the credentials below when using it.
ALLOW_MONGO_EXPRESS=0
#MONGO_EXPRESS_USERNAME="fakeUser12345"
#MONGO_EXPRESS_PASSWORD="FakePassword67890"

# Verbose logging (0 = false, 1 = true)
DEV_MODE=0
